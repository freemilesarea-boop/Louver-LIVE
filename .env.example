# Copy to .env and fill in. Nothing here has a default that would be safe to
# ship, which is why the server refuses to start rather than guessing.

# Seals every stored stream key. Generate once, keep it, back it up:
#   openssl rand -hex 32
# Change it and every saved destination becomes unreadable.
LOUVER_MASTER_KEY=

# Where the database, the uploads and the prepared copies live. Inside the
# container this is the mounted volume.
LOUVER_DATA_DIR=/var/lib/louver

# Host port to publish. Prefix with an address to restrict it —
# `127.0.0.1:8080` publishes to loopback only, which is what you want when Caddy
# or an SSH tunnel is the way in.
LOUVER_PORT=8080

# --- HTTPS (optional, needs a domain pointed at this server) ----------------
# With these two set, `docker compose --profile https up -d --build` puts Caddy
# in front and gets a certificate automatically. Then also set
# LOUVER_COOKIE_SECURE=always and LOUVER_PORT=127.0.0.1:8080 below, so the app
# itself is unreachable except through TLS.
# LOUVER_DOMAIN=live.example.com
# LOUVER_TLS_EMAIL=me@example.com

# When the session cookie carries `Secure`:
#   auto   (default) — Secure when the request arrived over HTTPS. Works behind
#                      a TLS proxy AND over a bare http://<ip>:8080.
#   always           — set this once HTTPS is in front.
#   never            — plain HTTP only.
# A browser never returns a `Secure` cookie over plain http, so `always` without
# HTTPS means the login succeeds and then every request answers 401.
LOUVER_COOKIE_SECURE=auto

# `cloud` on a server that stays on, `local` on a laptop. The web UI shows this
# at the top of every page, because it is what decides whether closing the lid
# ends a broadcast. The image already sets `cloud` for itself.
LOUVER_DEPLOYMENT=cloud

# The plan a new account starts on. Must be a plan id in the `plans` table
# (basic, pro, business are seeded); plans are rows, so adding one is a row.
LOUVER_DEFAULT_PLAN=basic

# The encoder used when an upload has to be re-encoded. libx264 everywhere;
# h264_nvenc on a host with an NVIDIA GPU passed through.
LOUVER_ENCODER=libx264

# Resource ceilings for the container. A stream-copy send costs almost no CPU;
# a transcode at upload time costs a core for about a third of the video's
# length, so leave headroom for the broadcasts already running.
LOUVER_CPUS=4
LOUVER_MEMORY=4g

# Set to 1 only for local HTTP development: it drops the Secure flag from the
# session cookie. Never set it on anything reachable from the internet.
# LOUVER_INSECURE_COOKIES=1

# Only for running Vite's dev server against a server elsewhere.
# VITE_LOUVER_API=http://localhost:8080
