# Copy to .env and fill in. Nothing here has a default that would be safe to
# ship, which is why the server refuses to start rather than guessing.

# Seals every stored stream key. Generate once, keep it, back it up:
#   openssl rand -hex 32
# Change it and every saved destination becomes unreadable.
LOUVER_MASTER_KEY=

# Where the database, the uploads and the prepared copies live. Inside the
# container this is the mounted volume.
LOUVER_DATA_DIR=/var/lib/louver

# Host port to publish. Prefix with an address to restrict it —
# `127.0.0.1:8080` publishes to loopback only, which is what you want when Caddy
# or an SSH tunnel is the way in.
LOUVER_PORT=8080

# --- HTTPS (optional, needs a domain pointed at this server) ----------------
# Leave these out entirely to run over http://<ip>:8080 — that is a supported
# deployment, and the Caddy service is not created at all without the `https`
# profile.
#
# With these two set, `docker compose --profile https up -d --build` puts Caddy
# in front and gets a certificate automatically. Then also set
# LOUVER_COOKIE_SECURE=always and LOUVER_PORT=127.0.0.1:8080 below, so the app
# itself is unreachable except through TLS.
# LOUVER_DOMAIN=live.example.com
# LOUVER_TLS_EMAIL=me@example.com

# When the session cookie carries `Secure`:
#   auto   (default) — Secure when the request arrived over HTTPS. Works behind
#                      a TLS proxy AND over a bare http://<ip>:8080.
#   always           — set this once HTTPS is in front.
#   never            — plain HTTP only.
# A browser never returns a `Secure` cookie over plain http, so `always` without
# HTTPS means the login succeeds and then every request answers 401.
LOUVER_COOKIE_SECURE=auto

# `cloud` on a server that stays on, `local` on a laptop. The web UI shows this
# at the top of every page, because it is what decides whether closing the lid
# ends a broadcast. The image already sets `cloud` for itself.
LOUVER_DEPLOYMENT=cloud

# Public signups start with **no** subscription and choose a plan afterwards, so
# this no longer decides what a new account gets. What it still decides is the
# plan `louver-server --create-user` gives when `--plan` is not passed — the
# operator's own account. `scripts/deploy-vps.sh` always passes `--plan`
# (business by default), so it is unaffected either way.
# Must be a plan id in the `plans` table: basic, pro or business.
LOUVER_DEFAULT_PLAN=basic

# The encoder used when an upload has to be re-encoded. libx264 everywhere;
# h264_nvenc on a host with an NVIDIA GPU passed through.
LOUVER_ENCODER=libx264

# Resource ceilings are OFF by default, and only read when you opt in with
#   docker compose -f docker-compose.yml -f docker-compose.limits.yml up -d
# LOUVER_CPUS must not exceed the host's core count: Docker rejects a larger
# value instead of ignoring it.
# LOUVER_CPUS=2
# LOUVER_MEMORY=3g

# Set to 1 only for local HTTP development: it drops the Secure flag from the
# session cookie. Never set it on anything reachable from the internet.
# LOUVER_INSECURE_COOKIES=1

# --- YouTube account connecting (optional) ----------------------------------
# Without these two, 247streams still sends video to a stream key you paste —
# that is the path that is on air — and the "YouTube 계정 연결" button is simply
# not offered. With them, 247streams can create the live broadcast itself, set
# its title, description and privacy, and ask YouTube for an ingestion address
# of its own.
#
# Names only in this file. Put the real values in `.env`, which is gitignored,
# and nowhere else: they are never stored in the database and never logged.
# Get them from an OAuth 2.0 **Web application** client at
# https://console.cloud.google.com/apis/credentials — see docs/YOUTUBE_OAUTH.md.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# Where Google sends the browser back to. Must match a redirect URI registered
# on that client **character for character**, including the scheme and any port.
# Google will not accept a bare IP address, so a production deployment needs a
# domain with HTTPS; until then, connect accounts from a local development
# server, where the default below works.
#   production:  https://live.example.com/api/youtube/oauth/callback
#   development: http://localhost:8080/api/youtube/oauth/callback  (the default)
# YOUTUBE_OAUTH_REDIRECT_URI=https://live.example.com/api/youtube/oauth/callback

# --- PayApp 정기결제 (optional) ---------------------------------------------
# Without these the server boots and streams exactly as it does now; only the
# checkout says "결제 시스템이 아직 설정되지 않았습니다." Names only in this file:
# put the real values in `.env`, which is gitignored. They are never stored in the
# database and never logged — see docs/PAYAPP.md.
#
# From the PayApp 판매자 관리페이지. 정기결제 사용 신청이 승인되어 있어야 합니다.
# PAYAPP_USERID=
# PAYAPP_LINKKEY=
# PAYAPP_LINKVAL=

# Where PayApp sends its notification and the browser back to. Required for
# billing: without it there is no address to give PayApp, and every payment would
# go unconfirmed. Must be the real public origin, not an IP.
# LOUVER_PUBLIC_URL=https://247streams.kr

# The official endpoint is the default; set this only to point at a test host.
# PAYAPP_API_URL=https://api.payapp.kr/oapi/apiLoad.html

# Only for running Vite's dev server against a server elsewhere.
# VITE_LOUVER_API=http://localhost:8080
