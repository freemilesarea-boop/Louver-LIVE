# Local cloud development: database, media and the dev master key.
.louver-dev/
apps/desktop/src-tauri/binaries/ffmpeg*
apps/desktop/src-tauri/binaries/ffprobe*
!apps/desktop/src-tauri/binaries/.gitkeep
tests/fixtures/*.mp4
tests/fixtures/*.mov
tests/fixtures/*.mkv
tests/fixtures/.generated
/tmp-test-output/
soak-results/
*.pem
private_key*
license-signing-key*
# The results directory is local, except for the one file that is a checklist
# rather than a result. Written as `rc-results/*` and not `rc-results/`,
# because git never descends into an excluded directory — with the directory
# itself ignored the negation below can never match, and the checklist could
# not be committed at all.
rc-results/*
!rc-results/youtube-test.md
tests/fixtures/rc/
